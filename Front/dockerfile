FROM node:18

# Set the working directory
WORKDIR /Front

# Copy package.json and package-lock.json first to leverage Docker cache
COPY package*.json ./

# Install dependencies
RUN npm install

# Now copy the rest of the application files
COPY . .

# Set environment variable for the app's port
ENV PORT=5173

# Expose the port
EXPOSE 5173

RUN npm run build

# Set default command to run the app in development mode
ENTRYPOINT ["npx", "serve"]
CMD ["-s", "dist", "-l", "5173"]